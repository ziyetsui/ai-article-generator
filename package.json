{
  "name": "ai-article-generator",
  "version": "1.0.0",
  "description": "AI-powered WeChat article generator with Liu Run writing style",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "cd frontend && npm start",
    "dev:backend": "cd backend && npm run dev",
    "build": "cd frontend && npm install && npm run build",
    "start": "vercel --prod"
  },
  "keywords": [
    "ai",
    "article",
    "generator",
    "wechat",
    "deepseek"
  ],
  "author": "徐子叶",
  "license": "ISC",
  "dependencies": {
    "@netlify/blobs": "^10.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "serverless-http": "^3.2.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.7"
  }
}
